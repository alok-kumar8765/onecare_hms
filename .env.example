# Environment: development | production
DJANGO_ENV=development
SECRET_KEY= 'django-insecure-)rwsqf1e%+btrv8mx*b5bk1wd$@4pt6j(mrzlu&vwz5*^(xrj='
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Development uses SQLite3; Production uses PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=onecare_hms
POSTGRES_USER=onecare_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Storage & Backups (Development uses local filesystem; Production uses S3-compatible storage)
STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=./var/media
BACKUP_DIR=./var/backups
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Licensing (Development uses isolated 'development' provider; Production enforces 'central')
LICENSE_PROVIDER=development
LICENSE_SERVER_URL=
LICENSE_PUBLIC_KEY=
LICENSE_OFFLINE_GRACE_HOURS=72

# External Providers (Development uses 'mock' adapters with zero paid API cost)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
PAYMENT_PROVIDER=mock
AI_PROVIDER=mock

