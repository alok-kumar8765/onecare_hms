# OneCare HMS — Git Ignore Rules

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Dependencies
.env
.env.local
.env.production
.env.staging
env/
venv/
ENV/
env.bak/
venv.bak/

# Local Databases & Dumps
*.sqlite3
db.sqlite3
*.db
*.sql
*.sql.gz
*.dump

# Local runtime & variable storage
var/
var/media/
var/backups/
var/exports/
media/
backups/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Private License Generator Secrets & Private Keys
tools/license_secrets/
*.pem
*.key
